# Vite Frontend Environment Variables
# NOTE: Variables must be prefixed with VITE_ to be exposed to the client

# Base URL for backend API. Defaults to same-origin '/api'.
# For local dev with a proxy or same-origin backend:
# VITE_API_BASE_URL=https://demo.crovncrm.com/api
VITE_API_BASE_URL=http://localhost:5000/api

# Example for a remote backend (uncomment and adjust):
# VITE_API_BASE_URL=https://api.yourdomain.com


